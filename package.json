{
  "name": "ai-ship",
  "version": "0.1.0",
  "description": "Project-agnostic OpenCode pipeline: worktree -> implement -> independent adversarial tests -> local verify -> parallel multi-lens review",
  "type": "module",
  "bin": {
    "ai-ship": "./bin/ai-ship.mjs"
  },
  "scripts": {
    "start": "node ./bin/ai-ship.mjs",
    "test": "node --test ./tests/*.test.ts",
    "typecheck": "tsc -p .",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.19.5",
    "opencode-ai": "^1.19.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
